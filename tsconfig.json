{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true, "types": ["node"],
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "src",
    "tests",
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": ["node_modules", "cloud"]
}